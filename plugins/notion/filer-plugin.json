{
  "name": "notion",
  "displayName": "Notion Integration",
  "version": "0.1.0",
  "description": "Create pages and append content to Notion databases",
  "author": { "name": "iyulab", "url": "https://github.com/iyulab" },
  "repository": "https://github.com/iyulab/filer-official-plugins",
  "license": "MIT",
  "keywords": ["notion", "documentation", "knowledge-base"],
  "runtime": "node",
  "engines": { "filer": ">=0.2.0" },
  "bundled": true,
  "capabilities": ["note-append"],
  "permissions": {
    "fetch": {
      "static": ["api.notion.com"]
    },
    "settings": true,
    "channels": { "getIntegrationConfig": true },
    "toast": true,
    "log": true,
    "store": true,
    "execution": { "timeout": "30s" }
  },

  "contributes": {
    "views": [
      {
        "id": "notion.history",
        "title": "History",
        "definition": "./views/history.view.json"
      }
    ],
    "settings": {
      "notion.apiKey": {
        "type": "string",
        "title": "API Key",
        "description": "Notion Internal Integration Token",
        "secret": true,
        "required": true,
        "order": 1
      },
      "notion.defaultDatabaseId": {
        "type": "string",
        "title": "Default Database ID",
        "description": "Notion database ID for creating new pages",
        "order": 2
      }
    },
    "tools": [
      {
        "id": "notion_create_page",
        "title": "Create Notion Page",
        "description": "Create a new page in a Notion database",
        "schema": "./tools/create-page.schema.json",
        "handler": "./tools/create-page.js"
      },
      {
        "id": "notion_append_block",
        "title": "Append to Notion Page",
        "description": "Append content to an existing Notion page",
        "schema": "./tools/append-block.schema.json",
        "handler": "./tools/append-block.js"
      }
    ]
  }
}
